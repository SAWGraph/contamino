# What are all the information that qualifies the results of measurement X?
# SUCCESSFULLY TESTED ON FRINK 2026-03-02

PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX coso: <http://w3id.org/coso/v1/contaminoso#>
PREFIX me_egad_data: <http://w3id.org/sawgraph/v2/me-egad-data#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX us_wqp_data: <http://w3id.org/sawgraph/v2/us-wqp-data#>

SELECT * 
WHERE{
    VALUES ?measurement{me_egad_data:d.egad.result.143291.L204794007RE.AAWHAAWH-WG1431616.20201030.68259121} #us_wqp_data:d.wqp.measurement.STORET-987908414
    ?measurement a coso:ContaminantMeasurement;
  		?p ?qualifier .			
  ?p rdfs:subPropertyOf coso:hasResultQualifier .
    
}